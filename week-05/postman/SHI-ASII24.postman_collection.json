          "raw": "{\n  \"id\": \"11111111-1111-1111-1111-111111111111\",\n  \"module_code\": \"MOD24\",\n  \"version\": \"1.0.0\",\n  \"owner_scope\": \"CENTRAL\",\n  \"specification\": {\n    \"openapi\": \"3.0.3\",\n    \"info\": {\n      \"title\": \"ASII-24\",\n      \"version\": \"1.0.0\"\n    },\n    \"paths\": {\n      \"/api/v1/api-contracts\": {\n        \"post\": {\n          \"responses\": {\n            \"201\": {\n              \"description\": \"Created\"\n            }\n          }\n        }\n      }\n    }\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/api-contracts",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "api-contracts"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
              "pm.environment.set('contractId', pm.response.json().data.id);"
            ]
